# AgentSoc 配置示例
# 复制为 .env 并填入真实值

# ===== 服务 =====
APP_NAME=AgentSoc
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ===== 数据库 =====
# SQLite（默认，单机零配置）
DATABASE_URL=sqlite:///./agentsentry.db
# 生产可用 PostgreSQL（M2 推荐）
# DATABASE_URL=postgresql://agentsoc:password@db:5432/agentsoc

# ===== Redis（可选，M2 启用：策略缓存 + 速率限制）=====
REDIS_URL=redis://localhost:6379/0

# ===== LLM Provider（放行后的真实后端透传，阶段 3 试点用）=====
# LLM_BACKEND:
#   mock   —— 内置回显（默认，不依赖外部，仅演示拦截）
#   openai —— 转发到 OpenAI 兼容网关（内网模型网关 / 火山引擎 / DeepSeek 等）
LLM_BACKEND=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 示例：接内网模型网关
# LLM_BACKEND=openai
# OPENAI_BASE_URL=http://gateway.internal/v1
# OPENAI_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== 判别模型（L3）=====
# CLASSIFIER_MODE:
#   disabled —— 空判别器（零分，只靠规则引擎）· 默认，无需下载模型
#   local    —— 本地 HuggingFace 模型（deberta-v3，~270MB，需能访问 HF）
#   remote   —— 远程 moderation API（阶段 3 试点：快速出误报数据）
CLASSIFIER_MODE=disabled
CLASSIFIER_THRESHOLD=0.7
# 本地模型配置（CLASSIFIER_MODE=local 时生效）
CLASSIFIER_MODEL_NAME=protectai/deberta-v3-base-prompt-injection-v2
CLASSIFIER_DEVICE=cpu
CLASSIFIER_CACHE_DIR=
# 远程判别模型配置（CLASSIFIER_MODE=remote 时生效）
# CLASSIFIER_MODE=remote
# CLASSIFIER_REMOTE_BASE_URL=http://gateway.internal/v1
# CLASSIFIER_REMOTE_API_KEY=sk-xxx
# CLASSIFIER_REMOTE_MODEL=gpt-4o-mini
CLASSIFIER_REMOTE_BASE_URL=
CLASSIFIER_REMOTE_API_KEY=
CLASSIFIER_REMOTE_MODEL=gpt-4o-mini
CLASSIFIER_REMOTE_TIMEOUT=5.0

# HuggingFace 镜像源（内网无法直连 HF 时设置，如 https://hf-mirror.com）
# HF_ENDPOINT=https://hf-mirror.com

# ===== 策略（C3 配置中心）=====
# POLICY_DIR：策略 YAML 目录，目录下所有 *.yaml 都会被自动扫描并归类
# POLICY_RELOAD_INTERVAL：热更新轮询间隔（秒），YAML 改动后最多该秒数内生效
POLICY_DIR=./policies
POLICY_RELOAD_INTERVAL=2

# ===== 审计 =====
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90

# ===== 安全（管理端点鉴权，阶段 1 安全自证）=====
# 设了 API_KEY 后，管理端点（/v1/policy/*、/v1/audit/*）需带 X-API-Key 头
API_KEY=
